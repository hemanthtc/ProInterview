# Gemini API Key for AI interviewer analysis and content generation
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (optional alternate voice or AI provider)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google OAuth Client ID for User Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# Merchant UPI ID for transactions or platform donations
NEXT_PUBLIC_MERCHANT_UPI_ID=your_upi_id_here@upi

# D-ID API Key for the talking head avatar video generator and WebRTC streams
DID_API_KEY=your_did_api_key_here
