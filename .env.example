# Gemini API Key for AI interviewer analysis and content generation
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID for User Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"

# Merchant UPI ID for transactions or platform donations
NEXT_PUBLIC_MERCHANT_UPI_ID=your_upi_id_here@upi

# D-ID API Key for the talking head avatar video generator and WebRTC streams
DID_API_KEY=your_did_api_key_here

# Google OAuth Client Secret for backend verification flow
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Base URL of the API for absolute links (default is localhost in development)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# MongoDB Atlas connection string for user authentication and sync
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/prointerview"

# Email configuration for sending actual verification codes (Gmail SMTP)
GMAIL_USER="your_gmail_address_here@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password_here"

# Razorpay Credentials for secure transactions
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_key_id_here"

# Happenstance API key for researching HR/recruiter contacts from interview emails
# Create a key at https://happenstance.ai (Settings → API). Without it, ProInterview falls back to Gemini-only guidance.
HAPPENSTANCE_API_KEY=your_happenstance_api_key_here

# Optional: Sarvam AI for Indic TTS + chat when Setup → provider = Sarvam
# https://sarvam.ai — used by /api/sarvam/tts and interview routes when aiProvider=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here

# Required: HMAC secret for session JWTs (min 32 characters). Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Optional: seed org accounts on first login (omit in production if unused)
# SEED_ADMIN_PASSWORD=
# SEED_EMPLOYEE_PASSWORD=
# SEED_ADMIN_IDENTIFIER=hemanthtchemu2003@gmail.com
# SEED_EMPLOYEE_IDENTIFIER=emp123

